---
import "../styles/global.css";
import { InvertedCursor } from "../components/InvertedCursor.tsx";
---

<script is:inline>
    const getThemePreference = () => {
        if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
        ) {
            return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    };
    const isDark = getThemePreference() === "dark";
    document.documentElement.classList[isDark ? "add" : "remove"]("dark");

    if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
            const isDark = document.documentElement.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        });
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }
</script>

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>sh42.me</title>
    </head>

    <body class="bg-texture bg-background">
        <InvertedCursor client:load />
        <main class="flex h-svh w-full items-center justify-center">
			<h1 class="font-zilla-slab text-6xl md:text-9xl font-normal tracking-tighter text-foreground select-none">
                sh42.me
            </h1>
        </main>
    </body>
</html>
