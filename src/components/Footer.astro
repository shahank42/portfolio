<footer class="grid justify-center lg:mx-auto w-full grid-cols-1 md:grid-cols-[1fr_minmax(0,var(--width-landing-container))_1fr] dark:bg-surface-1 row-start-3 row-end-4 border-t border-input">
    <!-- Left grid column -->
    <div class="border-r border-input"></div>
    
    <!-- Main footer content -->
    <div class="border-x-0 border-edge-primary p-6 py-16 pb-10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <!-- Left Column: Copyright -->
        <div class="text-sm text-secondary-foreground font-inter">
            &copy; {currentYear} Shounak Ghosh, All rights reserved.
            <div class="mt-1 opacity-60 text-xs">written in neovim and opencode ;-P</div>
        </div>

        <!-- Right Column: Navigation Links -->
        <nav>
            <ul class="flex items-center gap-x-6 font-inter text-sm">
                {footerLinks.map(link => (
                    <li>
                        <a href={link.href} class="text-muted-foreground hover:text-surface-foreground transition-colors duration-150">
                            {link.text}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>

    <!-- Right grid column -->
    <div class="border-l border-input"></div>
</footer>
