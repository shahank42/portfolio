---
// Get the current year dynamically for the copyright notice.
const currentYear = new Date().getFullYear();

// Define the navigation links.
const footerLinks = [
    { href: "/hire", text: "hire me" },
    { href: "/guestbook", text: "guestbook" },
    { href: "/experiments", text: "experiments" },
    { href: "https://www.youtube.com/watch?v=dQw4w9WgXcQ", text: "secret link" },
];
