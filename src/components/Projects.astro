---
import { CONTENT } from "@/lib/content";
import { ProjectsIsland } from "./ProjectsIsland";
---

<div class="grid justify-center lg:mx-auto border-b border-input grid-cols-1 md:grid-cols-[1fr_minmax(0,var(--width-landing-container))_1fr]">
  <div class="col-start-1 hidden md:block"></div>
  <ProjectsIsland
    client:load
    projects={CONTENT.projects}
  />
  <div class="md:col-start-3 hidden md:block"></div>
</div>
