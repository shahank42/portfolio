---
import { CONTENT } from "@/lib/content"
---

<div>
  <div class="grid md:hidden justify-center border-b border-edge-primary grid-cols-[var(--width-gutter)_minmax(0,calc(var(--container-7xl)-5rem))_var(--width-gutter)]">
    <div class="block col-start-1 md:col-start-2 border-e md:border-x border-input bg-[image:repeating-linear-gradient(315deg,_var(--color-gutter-edge)_0,_var(--color-gutter-edge)_1px,_transparent_0,_transparent_50%)] bg-[size:10px_10px] bg-fixed light:bg-surface-a1 dark:bg-black/20"></div>
    
    <div class="flex items-center justify-center">
      <div class="GoldenRatioLayoutMobile w-full block md:hidden relative">
        <svg class="absolute -z-[1] inset-0 pointer-events-none overflow-visible text-accent/60 -m-[0.5px]" viewBox="0 0 210 340" fill="none" xmlns="http://www.w3.org/2000/svg"><g><path d="M380.853 105.099L-201.625 464.632" stroke="var(--color-surface-5)" stroke-dasharray="4 12.56" vector-effect="non-scaling-stroke"></path><path d="M-165.247 -267.831L369.777 600.141" stroke="var(--color-surface-5)" stroke-dasharray="4 12.56" vector-effect="non-scaling-stroke"></path><path d="M209.5 260L130 260" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M129.5 339.5L129.5 210" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M159.5 260L159.5 210" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M3.09944e-06 210L209.5 210" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M160 240L130.133 240" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M149.5 240L149.5 260" stroke="currentColor" vector-effect="non-scaling-stroke"></path><rect x="159.5" y="210" width="30" height="30" transform="rotate(90 159.5 210)" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><rect x="149.5" y="240" width="20" height="20" transform="rotate(90 149.5 240)" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><rect x="159.5" y="240" width="20" height="10" transform="rotate(90 159.5 240)" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><path d="M149.643 239.897C155.106 239.897 159.619 244.414 159.619 249.882C159.619 255.35 155.106 259.868 149.643 259.868C138.717 259.868 129.69 250.833 129.69 239.897C129.69 223.493 143.23 209.941 159.619 209.941C186.935 209.941 209.5 232.527 209.5 259.868C209.5 303.613 173.396 339.75 129.69 339.75C58.6695 339.75 -1.22732e-05 281.027 -9.16589e-06 209.941C-4.14648e-06 95.1103 94.7738 0.24998 209.5 0.249985C395.69 0.250001 549.5 154.06 549.5 340.25" stroke="url(#paint0_linear_138_42)" vector-effect="non-scaling-stroke"></path></g><defs><linearGradient id="paint0_linear_138_42" x1="549.5" y1="113.142" x2="150.049" y2="239.893" class="text-primary-5"><stop offset="0.43" stop-color="currentColor"></stop><stop offset="1" stop-color="currentColor"></stop></linearGradient></defs></svg>
        
        <div class="GoldenLayoutTextMobile mx-auto relative grid grid-rows-[1.618fr_1fr] grid-cols-[1.618fr_minmax(0,1fr)] aspect-[1/1.618] overflow-hidden">
          <div class="GoldenLayoutTextMobileMainSquare p-4 xs:p-6 sm:p-8 flex flex-col gap-4 xs:gap-6 row-[1] col-[1/span_2]">
            <p class="text-md xs:text-lg xs:leading-2 lg:text-xl lg:leading-3 text-muted-foreground mb-2 ">{CONTENT.hero.sub}</p>
            <h1 class="text-3xl leading-8 xs:text-4xl xs:leading-8 sm:text-5xl sm:leading-9 font-medium dark:font-normal text-balance sm:mr-12">{CONTENT.hero.main}</h1>
            <!-- <p class=" max-w-lg text-3 leading-3 tracking-3 sm:text-4 sm:leading-4 sm:tracking-4 text-surface-10 text-balance">lorem10</p> -->
          </div>
          <div class="GoldenLayoutTextMobileRectangle p-4 flex flex-col gap-4 row-[2] col-[2]"></div>
          <div class="GoldenLayoutTextMobileSquare p-4 xs:p-6 sm:p-8 row-[2] col-[1/span_2] xs:col-[1]">tech stack</div>
        </div>
      </div>
    </div>
    <div class="block col-start-3 md:col-start-4 border-s md:border-x border-input bg-[image:repeating-linear-gradient(315deg,_var(--color-gutter-edge)_0,_var(--color-gutter-edge)_1px,_transparent_0,_transparent_50%)] bg-[size:10px_10px] bg-fixed light:bg-surface-a1 dark:bg-black/20"></div>
  </div>

  <div class="hidden md:grid justify-center lg:mx-auto border-b border-input grid-cols-1 md:grid-cols-[1fr_minmax(0,var(--width-landing-container))_1fr]">
    <div class="col-start-1 hidden md:block"></div>
    
    <div class="GoldenRatioLayoutDesktop border-l border-r border-b-0 border-edge-primary relative">
      <svg class="absolute inset-0 pointer-events-none overflow-visible text-accent/60 -m-[1.5px]" viewBox="0 0 340 210" fill="none" xmlns="http://www.w3.org/2000/svg"><g><path d="M105.1 -170.853L464.633 411.625" stroke="var(--color-surface-5)" stroke-dasharray="4 12.56" vector-effect="non-scaling-stroke"></path><path d="M-267.831 375.247L600.141 -159.777" stroke="var(--color-surface-5)" stroke-dasharray="4 12.56" vector-effect="non-scaling-stroke"></path><path d="M260 0.5V80" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M339.5 80.5H210" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M210 210V0.5" stroke="currentColor" vector-effect="non-scaling-stroke"></path><rect x="210" y="50.5" width="30" height="30" class="text-primary-5" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><rect x="240" y="60.5" width="20" height="20" class="text-primary-5" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><rect x="240" y="50.5" width="20" height="10" class="text-primary-5" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><path d="M239.897 60.3571C239.897 54.894 244.414 50.381 249.882 50.381C255.35 50.381 259.868 54.894 259.868 60.3571C259.868 71.2835 250.833 80.3095 239.897 80.3095C223.493 80.3095 209.941 66.7704 209.941 50.381C209.941 23.0652 232.527 0.499999 259.868 0.5C303.613 0.499995 339.75 36.6043 339.75 80.3095C339.75 151.33 281.027 210 209.941 210C95.1103 210 0.25 115.226 0.25 0.5C0.250008 -185.69 154.06 -339.5 340.25 -339.5" stroke="url(#paint0_linear_129_21)" vector-effect="non-scaling-stroke"></path></g><defs><linearGradient id="paint0_linear_129_21" x1="113.142" y1="-339.5" x2="239.893" y2="59.9511" class="text-primary-5"><stop offset="0.43" stop-color="currentColor"></stop><stop offset="1" stop-color="currentColor"></stop></linearGradient></defs></svg>
      <div class="absolute inset-0 pointer-events-none text-surface-8"><svg class="absolute -left-[6.5px] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -left-[6.5px] -bottom-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -right-[6.5px] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -right-[6.5px] -bottom-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute left-[61.2%] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg></div>

      <div class="GoldenLayoutTextDesktop relative grid grid-rows-[1fr_1.618fr] grid-cols-[1.618fr_minmax(0,1fr)] aspect-[1.618/1] overflow-hidden">
        <div class="GoldenLayoutTextDesktopMainSquare border-x px-8 lg:px-10 pt-10 flex flex-col gap-6 lg:gap-8 row-[1/span_2] col-[1]">
          <p class="text-lg leading-2 tracking-2 lg:text-xl lg:leading-3 lg:tracking-3 text-muted-foreground -mt-4">{CONTENT.hero.sub}</p>
          <h1 class="text-[36px] leading-[42px] lg:text-[48px] lg:leading-[64px] font-medium dark:font-normal text-balance">{CONTENT.hero.main}</h1>
          <!-- <p class="text-4 leading-4 tracking-4 lg:text-4 lg:leading-4 lg:tracking-4 text-surface-10 text-balance">lorem10</p> -->
        </div>
        <div class="GoldenLayoutTextDesktopRectangle p-4 flex flex-col gap-4 row-[1] col-[2]"></div>
        <div class="GoldenLayoutTextDesktopSquare border-t p-6 pt-4 lg:p-8 lg:pt-6 row-[2] col-[2]">tech stack</div>
      </div>
    </div>

    <div class="md:col-start-3 hidden md:block border-x border-input"></div>
  </div>
</div>
