    </div>
    <div class="block col-start-3 md:col-start-4 border-s md:border-x border-input bg-[image:repeating-linear-gradient(315deg,_var(--color-gutter-edge)_0,_var(--color-gutter-edge)_1px,_transparent_0,_transparent_50%)] bg-[size:10px_10px] bg-fixed light:bg-surface-a1 dark:bg-black/20"></div>
