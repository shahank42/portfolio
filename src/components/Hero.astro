---
import { CONTENT } from "@/lib/content"
---

<div>
  <div class="grid md:hidden justify-center border-b border-edge-primary grid-cols-[var(--width-gutter)_minmax(0,calc(var(--container-7xl)-5rem))_var(--width-gutter)]">
    <div class="block col-start-1 md:col-start-2 border-e md:border-x border-input bg-[image:repeating-linear-gradient(315deg,_var(--color-gutter-edge)_0,_var(--color-gutter-edge)_1px,_transparent_0,_transparent_50%)] bg-[size:10px_10px] bg-fixed light:bg-surface-a1 dark:bg-black/20"></div>
    
    <div class="flex items-center justify-center">
      <div class="GoldenRatioLayoutMobile w-full block md:hidden relative">
        <svg class="absolute -z-[1] inset-0 pointer-events-none overflow-visible text-accent/60 -m-[0.5px]" viewBox="0 0 210 340" fill="none" xmlns="http://www.w3.org/2000/svg"><g><path d="M380.853 105.099L-201.625 464.632" stroke="var(--color-surface-5)" stroke-dasharray="4 12.56" vector-effect="non-scaling-stroke"></path><path d="M-165.247 -267.831L369.777 600.141" stroke="var(--color-surface-5)" stroke-dasharray="4 12.56" vector-effect="non-scaling-stroke"></path><path d="M209.5 260L130 260" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M129.5 339.5L129.5 210" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M159.5 260L159.5 210" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M3.09944e-06 210L209.5 210" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M160 240L130.133 240" stroke="currentColor" vector-effect="non-scaling-stroke"></path><path d="M149.5 240L149.5 260" stroke="currentColor" vector-effect="non-scaling-stroke"></path><rect x="159.5" y="210" width="30" height="30" transform="rotate(90 159.5 210)" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><rect x="149.5" y="240" width="20" height="20" transform="rotate(90 149.5 240)" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><rect x="159.5" y="240" width="20" height="10" transform="rotate(90 159.5 240)" stroke="currentColor" vector-effect="non-scaling-stroke"></rect><path d="M149.643 239.897C155.106 239.897 159.619 244.414 159.619 249.882C159.619 255.35 155.106 259.868 149.643 259.868C138.717 259.868 129.69 250.833 129.69 239.897C129.69 223.493 143.23 209.941 159.619 209.941C186.935 209.941 209.5 232.527 209.5 259.868C209.5 303.613 173.396 339.75 129.69 339.75C58.6695 339.75 -1.22732e-05 281.027 -9.16589e-06 209.941C-4.14648e-06 95.1103 94.7738 0.24998 209.5 0.249985C395.69 0.250001 549.5 154.06 549.5 340.25" stroke="url(#paint0_linear_138_42)" vector-effect="non-scaling-stroke