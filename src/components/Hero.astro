        </div>
        <div class="GoldenLayoutTextDesktopRectangle p-4 flex flex-col gap-4 row-[1] col-[2]"></div>
        <div class="GoldenLayoutTextDesktopSquare border-t p-6 pt-4 lg:p-8 lg:pt-6 row-[2] col-[2]">
          <div class="LandingTech flex flex-col gap-4 lg:gap-6">
            <h2 class="hidden xs:block font-zilla-slab text-lg leading-2 tracking-tight sm:text-xl sm:leading-3 md:text-2xl md:leading-3 lg:text-3xl text-surface-foreground">my toolbox</h2>
            <div class="grid grid-cols-2 items-start gap-3 font-inter text-md leading-2 tracking-2">
              {CONTENT.hero.tools.map((tool) => (
                <div class="flex gap-2 items-center">
                  {/* <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-6 shrink-0"><path d="M12 13.8555C13.0355 13.8555 13.875 13.016 13.875 11.9805C13.875 10.945 13.0355 10.1055 12 10.1055C10.9645 10.1055 10.125 10.945 10.125 11.9805C10.125 13.016 10.9645 13.8555 12 13.8555Z" fill="#00D8FF"></path><path d="M12 16.2795C9.74636 16.3338 7.49839 16.03 5.34 15.3795C4.34297 15.0634 3.41305 14.5656 2.59725 13.911C2.28584 13.6875 2.02652 13.3992 1.83711 13.066C1.6477 12.7327 1.5327 12.3624 1.5 11.9805C1.5 10.7408 2.862 9.52575 5.1435 8.73075C7.35968 8.02689 9.67498 7.6855 12 7.71975C14.294 7.68803 16.5783 8.02326 18.7665 8.71275C19.7266 9.01922 20.6249 9.49301 21.42 10.1123C21.7257 10.3258 21.9808 10.6037 22.1674 10.9265C22.354 11.2493 22.4675 11.6091 22.5 11.9805C22.5 13.269 20.9775 14.5748 18.525 15.3863C16.4084 16.0158 14.2079 16.317 12 16.2795ZM12 8.61675C9.77563 8.58768 7.56077 8.91223 5.43825 9.57825C3.33825 10.311 2.397 11.313 2.397 11.9783C2.397 12.6743 3.40875 13.7685 5.63025 14.5283C7.69503 15.1478 9.84495 15.4361 12 15.3825C14.1123 15.4203 16.2179 15.1345 18.2438 14.535C20.55 13.7708 21.6 12.675 21.6 11.9805C21.562 11.7422 21.4751 11.5144 21.3447 11.3113C21.2144 11.1083 21.0434 10.9344 20.8425 10.8008C20.1313 10.2512 19.3287 9.83127 18.4717 9.56025C16.3784 8.90354 14.1937 8.58504 12 8.61675Z" fill="#00D8FF"></path><path d="M7.73971 21.3323C7.38984 21.3403 7.0441 21.2554 6.73771 21.0863C5.66371 20.4668 5.29171 18.6803 5.74246 16.3065C6.24001 14.035 7.10109 11.8587 8.29246 9.86176C9.41076 7.85876 10.8421 6.04741 12.5322 4.49626C13.2773 3.81759 14.1365 3.27601 15.0702 2.89651C15.4081 2.73867 15.7765 2.65686 16.1495 2.65686C16.5224 2.65686 16.8908 2.73867 17.2287 2.89651C18.3455 3.54001 18.7152 5.51101 18.194 8.04076C17.6817 10.1892 16.8429 12.2464 15.707 14.1405C14.6281 16.1199 13.2418 17.9155 11.6 19.4603C10.828 20.1658 9.93221 20.7225 8.95771 21.102C8.56767 21.2472 8.15582 21.325 7.73971 21.3323ZM9.06946 10.3073C7.93313 12.2195 7.1