      <div class="absolute inset-0 pointer-events-none text-surface-8"><svg class="absolute -left-[6.5px] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -left-[6.5px] -bottom-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -right-[6.5px] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute -right-[6.5px] -bottom-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg><svg class="absolute left-[61.2%] -top-[6.5px]" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" vector-effect="non-scaling-stroke"><path d="M6 0V12M0 6H12" stroke="currentColor"></path></svg></div>

      <div class="GoldenLayoutTextDesktop relative grid grid-rows-[1fr_1.618fr] grid-cols-[1.618fr_minmax(0,1fr)] aspect-[1.618/1] overflow-hidden">
        <div class="GoldenLayoutTextDesktopMainSquare border-x px-8 lg:px-10 pt-10 flex flex-col gap-6 lg:gap-8 row-[1/span_2] col-[1]">
          <p class="text-xl leading-2 tracking-tighter lg:text-2xl lg:leading-3 lg:tracking-tight text-muted-foreground -mt-4 font-inter">{CONTENT.hero.sub}</p>
          <div class="">
            <h1 class="text-5xl sm:text-5xl md:text-[3.3rem] leading-14 lg:text-7xl lg:leading-15 font-medium dark:font-normal font-zilla-slab">{CONTENT.hero.main1}</h1>
            <h1 class="text-5xl sm:text-5xl md:text-[3.3rem] leading-14 lg:text-7xl lg:leading-15 font-medium dark:font-normal font-zilla-slab">{CONTENT.hero.main2}</h1>
