        <div class="GoldenLayoutTextMobile mx-auto relative grid grid-rows-[1.618fr_1fr] grid-cols-[1.618fr_minmax(0,1fr)] aspect-[1/1.618] overflow-hidden">
          <div class="GoldenLayoutTextMobileMainSquare p-4 xs:p-6 sm:p-8 flex flex-col gap-4 xs:gap-6 row-[1] col-[1/span_2]">
            <p class="text-md xs:text-lg xs:leading-2 lg:text-xl lg:leading-3 text-muted-foreground mb-2 font-inter">{CONTENT.hero.sub}</p>
            <div class="">
              <h1 class="text-4xl leading-8 xs:text-5xl xs:leading-10 sm:text-6xl sm:leading-12 font-medium dark:font-normal text-balance sm:mr-12 font-zilla-slab">{CONTENT.hero.main1}</h1>
