            </div>
            <p class="max-w-lg text-md leading-5 tracking-tight sm:text-lg sm:leading-6 sm:tracking-4 text-surface-10 text-balance font-inter">{CONTENT.hero.paragraph1}</p>
            <p class="max-w-lg text-md leading-5 tracking-tight sm:text-lg sm:leading-6 sm:tracking-4 text-surface-10 text-balance font-inter">{CONTENT.hero.paragraph2}</p>
          </div>
